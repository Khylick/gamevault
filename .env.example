# Origine de GameVault utilisée dans les liens de connexion et le retour Steam.
APP_URL=http://localhost:3000

# Configuration de la session GameVault.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clés réservées au serveur. Utilise la clé secrète Supabase ou service_role en local.
SUPABASE_SECRET_KEY=
STEAM_WEB_API_KEY=

# Secret du planificateur Vercel pour les tâches Steam.
CRON_SECRET=

# Game Advisor. La clé OpenAI reste côté serveur.
OPENAI_API_KEY=
OPENAI_ADVISOR_MODEL=gpt-4.1-mini
